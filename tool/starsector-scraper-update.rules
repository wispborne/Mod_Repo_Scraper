// Lets david start starsector-scraper-update.service, and do nothing else with
// systemd, without a password. This is what the viewer's "Update" button needs.
//
// Install:
//   sudo cp starsector-scraper-update.rules /etc/polkit-1/rules.d/50-starsector-scraper-update.rules
// polkit picks it up on its own. Change "david" if the server runs as someone else.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "starsector-scraper-update.service" &&
      action.lookup("verb") == "start" &&
      subject.user == "david") {
    return polkit.Result.YES;
  }
});
