#!/bin/sh
# Counts the site's build number up by one, so every commit is one build on.
#
# Switched on with:
#   git config core.hooksPath githooks
# A fresh clone has to run that once — git will not use a checked-in hook by
# itself.
#
# The number is shown small and dim at the foot of the viewer's sidebar, so a
# bug report can say which build it came from. It is not a version of the
# program and it does not mean anything on its own — it only counts up.

version_file="web/version.json"

build=""
if [ -f "$version_file" ]; then
  build=$(sed -n 's/.*"build"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$version_file" | head -n 1)
fi

# A missing or unreadable file starts the count again rather than stopping the
# commit. A build number is never worth blocking someone's work over.
case "$build" in
  '' | *[!0-9]*) build=0 ;;
esac

build=$((build + 1))

if ! printf '{\n  "build": %s,\n  "updated": "%s"\n}\n' \
  "$build" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$version_file"; then
  echo "pre-commit: could not write $version_file, leaving the build number alone." >&2
  exit 0
fi

git add "$version_file" || {
  echo "pre-commit: could not stage $version_file." >&2
  exit 0
}
